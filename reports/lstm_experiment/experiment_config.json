{
  "series": [
    "Millet | 2.6 KG | Retail",
    "Oil (palm) | L | Retail",
    "Rice (imported) | 2.8 KG | Retail",
    "Rice (imported) | 50 KG | Wholesale",
    "Rice (local) | 2.7 KG | Retail",
    "Yam | 2.5 KG | Retail"
  ],
  "window_months": 12,
  "split": "chronological 70% train / 15% validation / 15% test by sequence target month",
  "transformations": [
    "original",
    "log1p",
    "price_change",
    "percentage_change"
  ],
  "selection_metric": "validation RMSE on reconstructed prices",
  "architecture": {
    "lstm_units": 32,
    "dropout": 0.2,
    "dense_units": 1
  },
  "optimizer": "Adam",
  "loss": "mean_squared_error",
  "max_epochs": 150,
  "early_stopping_patience": 15,
  "batch_size": 8,
  "random_seed": 42,
  "shuffle": false,
  "future_price_imputation": false,
  "forecast_horizons_months": [
    1,
    3,
    6
  ]
}